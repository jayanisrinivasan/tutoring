<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Study Drop — Tutoring by Jayani</title>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Nunito:wght@700;800;900&family=Nunito+Sans:wght@300;400;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --bg:#F5F0E8;
  --white:#FDFAF5;
  --machine-body:#EDE6D8;
  --machine-dark:#D4C9B5;
  --machine-darker:#B8AA94;
  --ink:#1C1C1C;
  --ink-soft:#555;
  --muted:#AAA09A;
  --navy:#0D1B3E;
  --orange:#F26419;
  --orange-dark:#C44F0A;
  --border:#CFC5B2;
  --slot-bg:#E8E1D4;
  --pixel:'Press Start 2P',monospace;
  --sans:'Nunito',sans-serif;
  --body:'Nunito Sans',sans-serif;
}
html{font-size:16px;}
body{
  background:var(--bg);
  color:var(--ink);
  font-family:var(--body);
  min-height:100vh;
  display:flex;flex-direction:column;align-items:center;
  padding:0 16px 80px;
}

/* NAV */
nav{
  width:100%;max-width:820px;
  padding:22px 0 18px;
  display:flex;align-items:flex-start;justify-content:space-between;
}
.nav-logo-top{font-family:var(--sans);font-weight:900;font-size:19px;color:var(--ink);letter-spacing:.5px;}
.nav-logo-sub{font-family:var(--sans);font-weight:700;font-size:11px;color:var(--orange);letter-spacing:2px;margin-top:2px;}
.nav-links{display:flex;gap:28px;padding-top:6px;}
.nav-links a{font-family:var(--sans);font-weight:700;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--ink);text-decoration:none;opacity:0.35;transition:opacity 0.15s;}
.nav-links a:hover{opacity:1;}
.nav-links a.active{opacity:1;color:var(--navy);border-bottom:2px solid var(--orange);padding-bottom:2px;}

.page{width:100%;max-width:520px;display:flex;flex-direction:column;align-items:center;}

/* ── ABOVE MACHINE: character + speech bubbles ── */
.above-machine{
  width:100%;
  display:flex;
  align-items:flex-end;
  justify-content:center;
  position:relative;
  margin-bottom:-2px;
  z-index:20;
}

/* jayani speech bubble - left side */
.bubble-jayani{
  position:absolute;
  left:0;
  bottom:90px;
  background:var(--white);
  border:2.5px solid var(--ink);
  border-radius:16px 16px 4px 16px;
  padding:12px 15px;
  max-width:168px;
  box-shadow:3px 3px 0 var(--ink);
  font-family:var(--sans);
  font-size:12px;
  font-weight:700;
  color:var(--ink);
  line-height:1.55;
  z-index:30;
}
.bubble-jayani::after{
  content:'';
  position:absolute;
  bottom:-12px;right:12px;
  border:6px solid transparent;
  border-top-color:var(--ink);
}
.bubble-jayani::before{
  content:'';
  position:absolute;
  bottom:-8px;right:14px;
  border:4px solid transparent;
  border-top-color:var(--white);
  z-index:1;
}

/* sherlock bubble - right side */
.bubble-sherlock{
  position:absolute;
  right:0;
  bottom:80px;
  background:var(--white);
  border:2.5px solid var(--ink);
  border-radius:16px 16px 16px 4px;
  padding:10px 16px;
  box-shadow:3px 3px 0 var(--ink);
  font-size:20px;
  z-index:30;
  line-height:1;
}
.bubble-sherlock::after{
  content:'';
  position:absolute;
  bottom:-12px;left:12px;
  border:6px solid transparent;
  border-top-color:var(--ink);
}
.bubble-sherlock::before{
  content:'';
  position:absolute;
  bottom:-8px;left:14px;
  border:4px solid transparent;
  border-top-color:var(--white);
  z-index:1;
}

.character-wrap{
  width:340px;
  flex-shrink:0;
  position:relative;
  z-index:20;
}
.character-wrap img{
  width:100%;display:block;
  image-rendering:pixelated;
  filter:drop-shadow(0 4px 14px rgba(28,28,28,0.15));
}

/* ── VENDING MACHINE ── */
.machine{
  width:100%;
  background:var(--machine-body);
  border-radius:20px 20px 14px 14px;
  border:3px solid var(--ink);
  box-shadow:
    inset -5px 0 0 var(--machine-dark),
    inset 0 -5px 0 var(--machine-dark),
    7px 9px 0 rgba(28,28,28,0.15);
  position:relative;
  padding:0 22px 22px;
  display:flex;flex-direction:column;align-items:center;gap:14px;
  z-index:10;
}

/* top stripe */
.machine-stripe{
  width:calc(100% + 6px);
  margin-left:-3px;
  height:12px;
  background:repeating-linear-gradient(90deg,var(--navy) 0,var(--navy) 20px,var(--orange) 20px,var(--orange) 28px);
  border-bottom:2.5px solid var(--ink);
  border-radius:17px 17px 0 0;
  margin-bottom:6px;
  flex-shrink:0;
}

/* screen */
.machine-screen{
  width:100%;
  background:var(--navy);
  border-radius:12px;
  border:2.5px solid var(--ink);
  box-shadow:inset 0 2px 10px rgba(0,0,0,0.5), 0 3px 0 var(--machine-darker);
  padding:16px 14px 14px;
  text-align:center;
  position:relative;
  overflow:hidden;
}
.machine-screen::after{
  content:'';position:absolute;inset:0;border-radius:10px;
  background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(255,255,255,0.025) 3px,rgba(255,255,255,0.025) 4px);
  pointer-events:none;
}
.machine-title{
  font-family:var(--pixel);font-size:11px;
  color:#fff;line-height:2;
  text-shadow:0 0 14px rgba(242,100,25,0.7);
  position:relative;z-index:1;
}
.machine-subtitle{
  font-family:var(--pixel);font-size:5.5px;
  color:var(--orange);margin-top:6px;letter-spacing:1.5px;opacity:0.85;
  position:relative;z-index:1;
}

/* side bolts decoration */
.bolts{
  width:100%;
  display:flex;justify-content:space-between;
  padding:0 4px;
  margin-top:-4px;
}
.bolt{
  width:10px;height:10px;border-radius:50%;
  background:var(--machine-darker);border:2px solid var(--ink);
}

/* slots panel */
.slots-panel{
  width:100%;
  background:var(--white);
  border-radius:12px;
  border:2px solid var(--ink);
  box-shadow:inset 0 2px 6px rgba(0,0,0,0.05), 0 3px 0 var(--machine-darker);
  padding:12px;
  display:flex;flex-direction:column;gap:7px;
}

.slot{
  display:flex;align-items:center;gap:10px;
  background:var(--slot-bg);
  border:1.5px solid var(--border);
  border-radius:9px;padding:9px 11px;
  cursor:pointer;
  transition:background 0.15s,border-color 0.15s,transform 0.1s;
  user-select:none;
}
.slot:hover{background:#E2DAC8;border-color:#B5A890;transform:translateX(3px);}
.slot.selected{background:#E2DAC8;border-color:var(--navy);}
.slot-code{
  font-family:var(--pixel);font-size:7.5px;
  background:var(--navy);color:var(--white);
  padding:5px 7px;border-radius:5px;
  min-width:29px;text-align:center;flex-shrink:0;
  box-shadow:0 2px 0 #06102A;
}
.slot.selected .slot-code{background:var(--orange);box-shadow:0 2px 0 var(--orange-dark);}
.slot-name{font-family:var(--sans);font-weight:800;font-size:13.5px;color:var(--ink-soft);flex:1;}
.slot.selected .slot-name{color:var(--ink);}
.slot-led{
  width:9px;height:9px;border-radius:50%;
  background:var(--border);border:1.5px solid #C0B8A8;
  flex-shrink:0;transition:all 0.2s;
}
.slot.selected .slot-led{background:var(--orange);border-color:var(--orange-dark);box-shadow:0 0 7px rgba(242,100,25,0.7);}

/* tray area */
.tray-area{
  width:100%;
  background:var(--machine-dark);
  border-radius:12px;
  border:2px solid var(--ink);
  box-shadow:inset 0 3px 8px rgba(0,0,0,0.12);
  padding:10px;
  display:flex;flex-direction:column;gap:9px;
}
.dispense-tray{
  background:#F5F0E8;
  border:2px solid var(--ink);
  border-radius:9px;
  min-height:80px;
  padding:14px 16px;
  display:flex;align-items:center;justify-content:center;
  overflow:hidden;
  box-shadow:inset 0 2px 10px rgba(0,0,0,0.5);
}
.tray-empty{
  font-family:var(--pixel);font-size:6px;
  color:#7A8099;
  text-align:center;line-height:2.5;
  letter-spacing:0.5px;
}
.tray-result{display:none;flex-direction:column;align-items:flex-start;width:100%;gap:5px;}
.tray-result.show{display:flex;animation:up 0.4s cubic-bezier(0.22,1,0.36,1);}
@keyframes up{from{transform:translateY(14px);opacity:0;}to{transform:translateY(0);opacity:1;}}
.result-label{font-family:var(--pixel);font-size:7px;color:var(--orange);margin-bottom:3px;letter-spacing:.5px;}
.result-items{font-family:var(--body);font-weight:600;font-size:12.5px;color:#2A3A5C;line-height:1.8;}
.result-book{
  display:inline-block;margin-top:10px;
  font-family:var(--sans);font-weight:800;font-size:12px;
  background:var(--orange);color:var(--white);
  padding:8px 18px;border-radius:100px;
  border:1.5px solid var(--orange-dark);
  text-decoration:none;
  box-shadow:0 2px 0 var(--orange-dark);
  transition:background 0.15s,transform 0.1s;
}
.result-book:hover{background:var(--orange-dark);transform:scale(1.03);}

.dispense-btn{
  width:100%;
  font-family:var(--pixel);font-size:9px;
  background:var(--orange);color:var(--white);
  border:2px solid var(--orange-dark);
  border-radius:8px;padding:13px;
  cursor:pointer;letter-spacing:1px;
  box-shadow:0 4px 0 var(--orange-dark);
  transition:transform 0.1s,box-shadow 0.1s,background 0.12s;
  text-shadow:0 1px 2px rgba(0,0,0,0.2);
}
.dispense-btn:hover{background:#FF7A30;}
.dispense-btn:active{transform:translateY(3px);box-shadow:0 1px 0 var(--orange-dark);}

/* legs */
.machine-legs{
  display:flex;justify-content:space-between;
  width:calc(100% - 80px);padding:0 16px;
  margin-top:-3px;
}
.leg{
  width:20px;height:18px;
  background:var(--machine-darker);
  border:2.5px solid var(--ink);border-top:none;
  border-radius:0 0 5px 5px;
}

/* TAGLINE */
.tagline{
  text-align:center;margin-top:22px;
  font-family:var(--body);font-size:15px;
  color:var(--muted);line-height:1.85;
}

/* SHERLOCK WIDGET */
.sherlock-bar{
  width:100%;margin-top:28px;
  border-top:1.5px dashed var(--border);
  padding-top:24px;
  display:flex;align-items:center;gap:16px;
}
.sherlock-bubble2{
  background:var(--white);border:1.5px solid var(--border);
  border-radius:14px;padding:11px 15px;
  font-family:var(--body);font-weight:600;font-size:13px;
  color:var(--ink-soft);line-height:1.5;flex:1;
  box-shadow:2px 2px 0 var(--border);position:relative;
}
.sherlock-bubble2::after{content:'';position:absolute;right:-10px;top:14px;border:5px solid transparent;border-left-color:var(--border);}
.sherlock-bubble2::before{content:'';position:absolute;right:-8px;top:15px;border:4px solid transparent;border-left-color:var(--white);z-index:1;}
.sherlock-right{display:flex;flex-direction:column;align-items:flex-end;gap:5px;flex-shrink:0;}
.sherlock-name{font-family:var(--sans);font-weight:900;font-size:14px;color:var(--ink);}
.sherlock-link{font-family:var(--sans);font-weight:700;font-size:12px;color:var(--orange);text-decoration:none;}
.sherlock-link:hover{text-decoration:underline;}

footer{margin-top:36px;font-family:var(--sans);font-weight:700;font-size:11px;color:var(--muted);letter-spacing:1px;}

/* ── SHERLOCK CHAT PANEL ── */
.sherlock-panel{{
  position:fixed;
  top:0;right:0;bottom:0;
  width:340px;max-width:100vw;
  background:var(--white);
  border-left:2.5px solid var(--ink);
  box-shadow:-6px 0 24px rgba(28,28,28,0.12);
  z-index:1000;
  display:flex;flex-direction:column;
  transform:translateX(110%);
  transition:transform 0.35s cubic-bezier(0.22,1,0.36,1);
}}
.sherlock-panel.open{{transform:translateX(0);}}

.panel-header{{
  background:var(--navy);
  padding:16px 18px;
  display:flex;align-items:center;gap:12px;
  border-bottom:2px solid var(--ink);
  flex-shrink:0;
}}
.panel-header-name{{
  font-family:var(--sans);font-weight:900;font-size:15px;color:#fff;flex:1;
}}
.panel-header-sub{{
  font-family:var(--sans);font-weight:400;font-size:11px;color:rgba(255,255,255,0.5);
}}
.panel-close{{
  background:none;border:none;color:rgba(255,255,255,0.6);
  font-size:20px;cursor:pointer;padding:0 4px;line-height:1;
  transition:color 0.15s;
}}
.panel-close:hover{{color:#fff;}}

.panel-messages{{
  flex:1;overflow-y:auto;
  padding:18px 16px;
  display:flex;flex-direction:column;gap:12px;
}}

.msg{{
  display:flex;gap:10px;align-items:flex-end;
  animation:msgIn 0.3s cubic-bezier(0.22,1,0.36,1);
}}
@keyframes msgIn{{from{{opacity:0;transform:translateY(8px);}}to{{opacity:1;transform:translateY(0);}}}}

.msg-avatar{{
  width:28px;height:28px;border-radius:50%;
  background:var(--navy);flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  font-size:14px;border:1.5px solid var(--ink);
}}
.msg-bubble{{
  background:var(--bg);
  border:1.5px solid var(--border);
  border-radius:14px 14px 14px 4px;
  padding:10px 13px;
  font-family:var(--body);font-size:13px;font-weight:400;
  color:var(--ink);line-height:1.6;
  max-width:240px;
}}
.msg.user{{flex-direction:row-reverse;}}
.msg.user .msg-bubble{{
  background:var(--navy);color:#fff;
  border-color:var(--navy);
  border-radius:14px 14px 4px 14px;
}}

.panel-options{{
  padding:12px 16px;
  display:flex;flex-wrap:wrap;gap:8px;
  border-top:1px solid var(--border);
  flex-shrink:0;
}}
.opt-btn{{
  font-family:var(--sans);font-weight:700;font-size:12px;
  background:var(--white);color:var(--navy);
  border:1.5px solid var(--navy);
  border-radius:100px;padding:7px 14px;
  cursor:pointer;transition:background 0.15s,color 0.15s;
}}
.opt-btn:hover{{background:var(--navy);color:#fff;}}

.panel-result{{
  padding:14px 16px;
  background:var(--orange-pale, #FEF0E4);
  border-top:2px solid var(--border);
  flex-shrink:0;
  display:none;
}}
.panel-result.show{{display:block;animation:msgIn 0.3s ease;}}
.result-code{{
  font-family:var(--pixel);font-size:10px;
  color:var(--orange);margin-bottom:6px;
}}
.result-rec{{
  font-family:var(--sans);font-weight:700;font-size:13px;
  color:var(--ink);margin-bottom:10px;line-height:1.5;
}}
.result-select-btn{{
  font-family:var(--sans);font-weight:800;font-size:12px;
  background:var(--navy);color:#fff;
  border:none;border-radius:100px;
  padding:9px 18px;cursor:pointer;
  transition:background 0.15s;
}}
.result-select-btn:hover{{background:var(--orange);}}

.overlay{{
  position:fixed;inset:0;background:rgba(0,0,0,0.25);
  z-index:999;opacity:0;pointer-events:none;
  transition:opacity 0.3s;
}}
.overlay.show{{opacity:1;pointer-events:all;}}
</style>
</head>
