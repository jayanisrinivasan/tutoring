  A2: { name: "Science", items: "K-8 Science · AP Biology · AP Chemistry · AP Environmental Science · AP Psychology" },
  B1: { name: "English", items: "K-8 Reading and Writing · Essay Writing · Literary Analysis · AP Language and Composition · AP Literature" },
  B2: { name: "SAT / ACT", items: "SAT Math and Reading · ACT All Sections · PSAT · Custom study plans · Full practice tests" },
  C1: { name: "AP Exams", items: "Structured exam prep · Past paper practice · Concept review · Exam strategy" },
  C2: { name: "College Advising", items: "School list building · Common App guidance · Personal statement · Supplemental essays · Application timeline" }
};
function selectSlot(el) {
  document.querySelectorAll('.slot').forEach(function(s) { s.classList.remove('selected'); });
  el.classList.add('selected');
  selected = el.dataset.code;
  document.getElementById('tray-result').classList.remove('show');
  document.getElementById('tray-empty').style.display = '';
}
function dispense() {
  if (!selected) { document.getElementById('tray-empty').textContent = 'pick a slot first!'; return; }
  var d = slotData[selected];
  document.getElementById('result-label').textContent = selected + ' / ' + d.name;
  document.getElementById('result-items').textContent = d.items;
  document.getElementById('tray-empty').style.display = 'none';
  var r = document.getElementById('tray-result');
  r.classList.remove('show'); void r.offsetWidth; r.classList.add('show');
}
</script>
</body>
</html>
